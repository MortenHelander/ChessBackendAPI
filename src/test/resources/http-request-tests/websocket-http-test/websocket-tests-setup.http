###Register and login two users then check websocket connections

###register user 1
POST {{baseUrl}}/api/v1/auth/register
Accept: application/json
Content-Type: application/json

{
  "username": "mohel",
  "firstName": "Morten",
  "lastName": "Helander",
  "email": "morten@example.com",
  "password": "Str0ng!Passw0rd",
  "passwordCheck": "Str0ng!Passw0rd"
}

###register user 2
POST {{baseUrl}}/api/v1/auth/register
Accept: application/json
Content-Type: application/json

{
  "username": "anderson",
  "firstName": "Andreas",
  "lastName": "Jensen",
  "email": "andreas@example.com",
  "password": "Str0ng!Passw0rd",
  "passwordCheck": "Str0ng!Passw0rd"
}

###login user 1 and save id and token
POST {{baseUrl}}/api/v1/auth/login
Accept: application/json
Content-Type: application/json

{
  "username": "mohel",
  "password": "Str0ng!Passw0rd"
}

> {%
    client.global.set("token1", response.body.token);
    client.global.set("user1Id", response.body.id);
%}

###login user 2 and save id and token
POST {{baseUrl}}/api/v1/auth/login
Accept: application/json
Content-Type: application/json

{
  "username": "anderson",
  "password": "Str0ng!Passw0rd"
}

> {%
    client.global.set("token2", response.body.token);
    client.global.set("user2Id", response.body.id);
%}

###Create game 1
POST {{baseUrl}}/api/v1/games
Authorization: Bearer {{token1}}
Content-Type: application/json

{
  "whiteUserId": {{user1Id}},
  "blackUserId": {{user2Id}},
  "gameMode": "CLASSIC"
}

> {%
    client.global.set("gameId", response.body.id);
%}